# Salin file ini ke .dev.vars untuk development lokal
# .dev.vars JANGAN di-commit ke Git

# Password untuk /admin
ADMIN_PASSWORD=ganti-dengan-password-kamu

# API read-only dari tiktok-live-konektor.
# Nilainya harus sama dengan API_KEY di service tiktok-live-konektor.
TIKTOK_CONNECTOR_API_KEY=ganti-dengan-api-key-connector

# Secret webhook push dari tiktok-live-konektor ke Worker ini.
TIKTOK_CONNECTOR_WEBHOOK_SECRET=ganti-dengan-token-acak

# Legacy fallback: hanya diperlukan bila masih memakai POST /api/live/trigger.
LIVE_SECRET=ganti-dengan-token-acak
