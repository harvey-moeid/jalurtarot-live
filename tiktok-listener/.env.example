# Salin file ini ke .env (jangan commit .env ke git)

# Username TikTok yang live (tanpa @), contoh: https://www.tiktok.com/@namamu/live -> namamu
TIKTOK_USERNAME=namamu

# URL Worker Cloudflare kamu (tanpa slash di akhir)
WORKER_URL=https://livejalur.muidsoft.com

# Harus SAMA PERSIS dengan LIVE_SECRET yang di-set di Worker
# (wrangler secret put LIVE_SECRET)
LIVE_SECRET=ganti-dengan-token-acak

# (rev11) Nama gift SPESIFIK yang jadi pemicu (case-insensitive, mis. "Rose").
# Kosongkan atau isi "*" supaya SEMUA gift bisa memicu - jumlah kartu ditentukan
# dari nilai KOIN gift (diamondCount x repeatCount), bukan nama gift.
TARGET_GIFT_NAME=*

# Nilai koin minimum agar gift memicu draw sama sekali (0 = gift gratis pun bisa memicu)
MIN_GIFT_VALUE=1

# Kalau nilai koin gift >= angka ini, otomatis tarik 3 kartu. Di bawah itu, 1 kartu.
# Contoh: gift senilai 5 koin -> 3 kartu; gift senilai 1-4 koin -> 1 kartu.
THREE_CARD_MIN_VALUE=5

# Susunan kartu default (dipakai kalau nilai koin di bawah THREE_CARD_MIN_VALUE): "single" atau "three-card"
DEFAULT_SPREAD=single

# (Opsional) Setiap total like di sesi live menembus kelipatan angka ini,
# otomatis tarik 1 kartu untuk pengirim like terakhir. Kosongkan untuk nonaktifkan.
LIKE_MILESTONE=1000

# (Opsional) Euler Stream sign API key - hanya perlu kalau kena rate limit
# koneksi gratis. Daftar di https://www.eulerstream.com/ kalau diperlukan.
# SIGN_API_KEY=