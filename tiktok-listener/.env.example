# Salin file ini ke .env (jangan commit .env ke git)

# Username TikTok yang live (tanpa @), contoh: https://www.tiktok.com/@namamu/live -> namamu
TIKTOK_USERNAME=namamu

# URL Worker Cloudflare kamu (tanpa slash di akhir)
WORKER_URL=https://jalurtarotfree.workers.dev

# Harus SAMA PERSIS dengan LIVE_SECRET yang di-set di Worker
# (wrangler secret put LIVE_SECRET)
LIVE_SECRET=ganti-dengan-token-acak

# Nama gift TikTok yang jadi pemicu penarikan kartu.
# Lihat nama gift persis di panel TikTok Studio / saat live berjalan
# (case-insensitive, dicocokkan ke data.giftName)
TARGET_GIFT_NAME=Rose

# Minimal jumlah gift dalam satu combo agar trigger jalan (1 = langsung trigger)
MIN_GIFT_COUNT=1

# Susunan kartu yang ditarik saat gift target masuk: "single" atau "three-card"
DEFAULT_SPREAD=single

# (Opsional) Kalau MIN_GIFT_COUNT terlampaui jauh (misal >= angka ini),
# otomatis tarik 3 kartu meski DEFAULT_SPREAD=single. Kosongkan untuk nonaktifkan.
THREE_CARD_THRESHOLD=5

# (Opsional) Euler Stream sign API key — hanya perlu kalau kena rate limit
# koneksi gratis. Daftar di https://www.eulerstream.com/ kalau diperlukan.
# SIGN_API_KEY=
