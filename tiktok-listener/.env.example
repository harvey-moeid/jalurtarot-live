# Jangan commit file .env atau bagikan token.
TIKTOK_USERNAME=jalurtarot
WORKER_URL=https://livejalur.muidsoft.com
LIVE_SECRET=isi-sama-dengan-secret-worker

# Euler Stream API key (diperlukan untuk managed WebSocket berautentikasi).
# Masukkan di environment Render atau .env lokal. Jangan tempel di chat/log.
EULER_API_KEY=

# Alias lama tetap dibaca bila masih memakai SIGN_API_KEY.
SIGN_API_KEY=

# Kosong atau * = semua gift; atau isi nama gift tertentu.
TARGET_GIFT_NAME=*
MIN_GIFT_VALUE=1
THREE_CARD_MIN_VALUE=5
DEFAULT_SPREAD=single
LIKE_MILESTONE=1000

RECONNECT_MIN_MS=5000
RECONNECT_MAX_MS=60000
WORKER_TIMEOUT_MS=10000
